{
	"name": "vault-full-statistics",
	"version": "1.25.0",
	"description": "Vault statistics in the status bar plus a dedicated view with own/source ratio and a 30-day sparkline of how your knowledge base evolves.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest --config jest.config.js",
		"lint": "oxlint"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"statistics",
		"vault",
		"metrics",
		"knowledge-management"
	],
	"author": "Mikhail Savin <jtprogru@gmail.com>",
	"readme": "README.md",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jtprogru/obsidian-vault-full-statistics-plugin.git"
	},
	"homepage": "https://github.com/jtprogru/obsidian-vault-full-statistics-plugin#readme",
	"bugs": {
		"url": "https://github.com/jtprogru/obsidian-vault-full-statistics-plugin/issues"
	},
	"devDependencies": {
		"@swc/core": "^1.16.1",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.4.0",
		"esbuild": "^0.28.2",
		"jest": "^30.5.0",
		"obsidian": "1.13.1",
		"oxlint": "^1.80.0",
		"tslib": "^2.8.1",
		"typescript": "^7.0.2"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
